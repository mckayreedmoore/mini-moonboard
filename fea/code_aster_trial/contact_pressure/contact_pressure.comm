# Small method fixture only: stock frictionless CONTINUE contact.
# Units: mm, N, MPa. Each 2-D block is plane strain with unit depth.
DEBUT(CODE="OUI", ERREUR=_F(ALARME="EXCEPTION"))

MAIL = LIRE_MAILLAGE(FORMAT="ASTER", UNITE=20)
MODE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=_F(GROUP_MA=("BLK_L", "BLK_R"), PHENOMENE="MECANIQUE", MODELISATION="D_PLAN"),
)

MATER = DEFI_MATERIAU(ELAS=_F(E=1000.0, NU=0.25))
CHMAT = AFFE_MATERIAU(MAILLAGE=MAIL, AFFE=_F(TOUT="OUI", MATER=MATER))

CHARX = AFFE_CHAR_MECA(
    MODELE=MODE,
    DDL_IMPO=(
        _F(TOUT="OUI", DY=0.0),
        _F(GROUP_NO="LEFT", DX=0.0),
        _F(GROUP_NO="RIGHT", DX=1.0),
    ),
)
F_HIST = DEFI_FONCTION(
    NOM_PARA="INST",
    VALE=(
        0.00, 0.00,
        0.25, 0.05,
        0.50, 0.15,
        0.75, 0.20,
        1.00, 0.10,
        1.25, 0.00,
        1.50, -0.10,
        1.75, -0.20,
        2.00, -0.40,
        2.25, -0.30,
        2.50, -0.20,
        2.75, -0.10,
        3.00, 0.00,
        3.25, 0.10,
    ),
)
L_INST = DEFI_LIST_REEL(
    VALE=(0.00, 0.25, 0.50, 0.75, 1.00, 1.25, 1.50,
          1.75, 2.00, 2.25, 2.50, 2.75, 3.00, 3.25),
)

CONTACT = DEFI_CONTACT(
    MODELE=MODE,
    FORMULATION="CONTINUE",
    FROTTEMENT="SANS",
    ZONE=_F(GROUP_MA_MAIT="MASTER", GROUP_MA_ESCL="SLAVE"),
)

RESU = STAT_NON_LINE(
    MODELE=MODE,
    CHAM_MATER=CHMAT,
    COMPORTEMENT=_F(RELATION="ELAS", DEFORMATION="PETIT"),
    EXCIT=_F(CHARGE=CHARX, FONC_MULT=F_HIST),
    CONTACT=CONTACT,
    INCREMENT=_F(LIST_INST=L_INST),
    CONVERGENCE=_F(RESI_GLOB_MAXI=1.0E-9, ITER_GLOB_MAXI=30),
)
RESU = CALC_CHAMP(reuse=RESU, RESULTAT=RESU, FORCE=("FORC_NODA",))

# Documentation-backed post-processing only. The interface is straight,
# remains vertical because DY=0, and uses the initial normal in this check.
RESU = CALC_PRESSION(
    reuse=RESU,
    MAILLAGE=MAIL,
    RESULTAT=RESU,
    GROUP_MA=("SLAVE",),
    TOUT_ORDRE="OUI",
    GEOMETRIE="INITIALE",
)

TAB_CONT = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="SLAVE_CONTACT",
        RESULTAT=RESU,
        NOM_CHAM="CONT_NOEU",
        GROUP_NO="SLAVE_NODES",
        TOUT_ORDRE="OUI",
        TOUT_CMP="OUI",
    ),
)
TAB_END = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="RIGHT_END_REACTION",
        RESULTAT=RESU,
        NOM_CHAM="FORC_NODA",
        GROUP_NO="RIGHT",
        TOUT_ORDRE="OUI",
        TOUT_CMP="OUI",
    ),
)
TAB_PRES = POST_RELEVE_T(
    ACTION=_F(
        OPERATION="EXTRACTION",
        INTITULE="SLAVE_CONTACT_PRESSURE",
        RESULTAT=RESU,
        NOM_CHAM="PRES_NOEU",
        GROUP_NO="SLAVE_NODES",
        TOUT_ORDRE="OUI",
        TOUT_CMP="OUI",
    ),
)

for TABLE, UNIT in ((TAB_CONT, 81), (TAB_END, 82), (TAB_PRES, 83)):
    IMPR_TABLE(
        TABLE=TABLE,
        FORMAT="TABLEAU",
        UNITE=UNIT,
        SEPARATEUR=";",
        FORMAT_R="E24.16",
    )

FIN()
