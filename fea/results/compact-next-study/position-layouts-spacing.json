  "launch_source": "import copy,hashlib,json,tempfile\nfrom pathlib import Path\nimport numpy as np\nfrom mini_moonboard.compact_three_leg_options import option\n\nsource=Path('scripts/compact_layout_options.py')\ncode=source.read_text().replace('for n in (4, 2, 3):','for n in (3,):').replace('for d in (0.375, 0.5, 0.625, 0.75, 0.875, 1.):','for d in (0.5,):')\ncode=code.replace('range(math.ceil(4 * d * 25.4), 151, 5)', 'range(64, 151, 2)')\nns={'__file__':str(source.resolve()),'__name__':'bounded_position_screen'}\nexec(compile(code,str(source), 'exec'),ns)\noriginal_geometry=Path('fea/results/compact-options-study/upper150-rear/geometry.json')\nreport=Path('fea/results/compact-options-study/upper150-rear/report.json.gz')\nbase=json.loads(original_geometry.read_text())\nresults=[]\nfor label in ('upper225','upper300'):\n c=option(label); _,foot,grain,normal,top,_,_=c.leg_datums()\n geo=copy.deepcopy(base)\n center=(foot+top)/2\n bottom=[]\n for offset in (-69.85,69.85):\n  point=foot+normal*offset\n  point-=grain*(point.z/grain.z)\n  bottom.append(point)\n ends=[max((p-center).dot(grain) for p in bottom),(top-center).dot(grain)]\n for side in ('left','right'):\n  row=geo['members']['lumber_leg_'+side]\n  row.update(grain=list(grain.toTuple()),centre_mm=[row['centre_mm'][0],center.y,center.z],end_stations_mm=ends)\n with tempfile.TemporaryDirectory(prefix='compact-position-') as directory:\n  gp=Path(directory)/'geometry.json';gp.write_text(json.dumps(geo))\n  r=ns['build'](report,gp,expected_candidate='compact-leg-upper150-development')\n  r['source_sha256'].pop(str(gp))\n r.update(candidate=c.KEY,source_candidate=base['candidate'],held_wrench_only=True,\n          proposed_leg_geometry={name:{key:geo['members'][name][key] for key in ('grain','centre_mm','end_stations_mm','depth_mm','width_mm')} for name in ('lumber_leg_left','lumber_leg_right')},\n          note='The only solved forces are the archived upper150 wrenches. Leg axes/ends here are the proposed physical stock. No native result exists for this placement.')\n r['bounds']['diameters_in']=[.5]\n r['bounds']['bolt_counts_per_leg']=[3]\n r['bounds']['three_four_bolt_layouts']='3-bolt omitted-corner parallelogram, a,b64..150mm in2mm steps; aligned component pitch at least5D=63.5mm'\n results.append(r)\n print(label,json.dumps(r['results'][0]),flush=True)\nout=Path('fea/results/compact-next-study/position-layouts-spacing.json');out.parent.mkdir(parents=True,exist_ok=True)\nout.write_text(json.dumps({'cases':results,'source_sha256':{str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in (source,Path('mini_moonboard/compact_three_leg_options.py'),report,original_geometry)},'launch_source':Path(__file__).read_text(),'scope':'Held upper150 wrenches only; actual proposed grain and full-depth end bounds; no assembly prediction.'},indent=2)+'\\n')\n",
