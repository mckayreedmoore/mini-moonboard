import hashlib
import json
import math
from pathlib import Path
import re
import shutil

root = Path.cwd()
dest = root/'docs/wood-joints-mvp/hypotheses/evaluation-resume-2026-09-24/axial-mpc-benchmark-attempt01'
digest = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()
assert digest(dest/'manifest.json') == 'f671c3b611f5c7d8945dcfe962a556da9afd6ae3622fca6ef7dbf71f00e671dd'
assert digest(dest/'axial-mean-mpc.inp') == 'a454f6fa6ad3e7e207568bed19098c368f0272d007fe3ead082427bf403f2145'
execution = json.loads((dest/'execution.json').read_text())
assert execution['status']=='completed' and execution['returncode']==0 and execution['sources_unchanged_after_run'] is True
for path,expected in execution['artifacts_sha256'].items(): assert digest(dest/path)==expected,path
manifest = json.loads((dest/'manifest.json').read_text())
tol = manifest['absolute_tolerances']
assert tol == {'reference_and_weighted_mean_displacement_mm':1e-6,'mpc_residual_mm':1e-6,'integration_point_stress_mpa':0.02,'integration_point_strain':1e-7,'bottom_nodal_reaction_n':0.1,'global_force_residual_n':0.1,'global_moment_residual_nmm':1.,'gauge_force_n':0.1,'rotation_gauge_moment_nmm':1.}
log = (dest/'axial-mean-mpc.log').read_text()
assert 'CalculiX Version 2.21' in log and 'Job finished' in log
assert not re.search(r'\*ERROR|singular|diverg',log,re.I)
sta = [line.split() for line in (dest/'axial-mean-mpc.sta').read_text().splitlines() if line.strip() and line.split()[0].isdigit()]
assert len(sta)==1 and sta[0][:4]==['1','1','1','1']
assert all(abs(float(v)-1)<1e-12 for v in sta[0][4:])
blocks = {}
mode = None
for line in (dest/'axial-mean-mpc.dat').read_text().splitlines():
    s=line.strip()
    header=next((name for name in ('displacements','forces','stresses','strains') if s.startswith(name+' (')),None)
    if header:
        assert header not in blocks,header
        assert float(s.rsplit('time',1)[1])==1.0
        mode=header;blocks[mode]={};continue
    if not s: continue
    if mode is None: continue
    cells=s.split()
    assert cells[0].isdigit(),s
    start=1 if mode in ('displacements','forces') else 2
    assert len(cells)==(4 if start==1 else 8),s
    key=tuple(map(int,cells[:start]));values=tuple(map(float,cells[start:]))
    assert all(math.isfinite(v) for v in values) and key not in blocks[mode]
    blocks[mode][key]=values
nodes={*range(1,19),*range(21,29),900,901}
for key in ('displacements','forces'): assert set(blocks[key])=={(n,) for n in nodes}
points={(element,point) for element in range(1,5) for point in range(1,9)}
for key in ('stresses','strains'): assert set(blocks[key])==points
u={key[0]:v for key,v in blocks['displacements'].items()}
rf={key[0]:v for key,v in blocks['forces'].items()}
force=1000.;E=200000.;area=100.;length=100.;nu=.3
strain=force/(E*area);delta=strain*length
weights=(1/16,1/8,1/16,1/8,1/4,1/8,1/16,1/8,1/16)
max_u_error=0.
for n in range(1,19):
    local=(n-1)%9;x=(local%3)*5.;y=(local//3)*5.;z=0. if n<10 else length
    expected=(-nu*strain*(x-5),-nu*strain*(y-5),strain*z)
    error=max(abs(u[n][i]-expected[i]) for i in range(3));max_u_error=max(max_u_error,error)
assert max_u_error<=tol['reference_and_weighted_mean_displacement_mm']
for n in (*range(21,29),900): assert max(abs(u[n][i]-(delta if i==2 else 0.)) for i in range(3))<=tol['reference_and_weighted_mean_displacement_mm']
assert max(map(abs,u[901]))<=tol['reference_and_weighted_mean_displacement_mm']
mean=sum(w*u[n][2] for n,w in zip(range(10,19),weights))
mpc_residual=mean-u[900][2]
assert abs(mpc_residual)<=tol['mpc_residual_mm']
max_bottom_error=0.;max_top_error=0.
for i,w in enumerate(weights,1):
    max_bottom_error=max(max_bottom_error,max(abs(rf[i][k]-(-force*w if k==2 else 0.)) for k in range(3)))
    max_top_error=max(max_top_error,max(abs(rf[i+9][k]-(force*w if k==2 else 0.)) for k in range(3)))
assert max_bottom_error<=tol['bottom_nodal_reaction_n']
assert max_top_error<=tol['bottom_nodal_reaction_n']
max_stress_error=max(abs(v[i]-([0.,0.,force/area,0.,0.,0.][i])) for v in blocks['stresses'].values() for i in range(6))
max_strain_error=max(abs(v[i]-([-nu*strain,-nu*strain,strain,0.,0.,0.][i])) for v in blocks['strains'].values() for i in range(6))
assert max_stress_error<=tol['integration_point_stress_mpa']
assert max_strain_error<=tol['integration_point_strain']
cross=lambda a,b:(a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0])
support=tuple(sum(rf[n][i] for n in range(1,10)) for i in range(3))
support_moment=tuple(sum(cross((((n-1)%3)*5.,((n-1)//3)*5.,0.),rf[n])[i] for n in range(1,10)) for i in range(3))
force_residual=tuple(support[i]+(force if i==2 else 0.) for i in range(3))
load_moment=cross((5.,5.,100.),(0.,0.,force))
moment_residual=tuple(support_moment[i]+load_moment[i] for i in range(3))
assert max(map(abs,force_residual))<=tol['global_force_residual_n']
assert max(map(abs,moment_residual))<=tol['global_moment_residual_nmm']
guide_values=[rf[5][0],rf[5][1],rf[6][1],rf[900][0],rf[900][1]]
assert max(map(abs,guide_values))<=tol['gauge_force_n']
assert max(map(abs,rf[901]))<=tol['rotation_gauge_moment_nmm']
output={
 'status':'PASS_SCALAR_AXIAL_MPC_IMPLEMENTATION_FIXTURE_ONLY',
 'native_current_joint_run':False,
 'manifest_sha256':digest(dest/'manifest.json'),
 'execution_sha256':digest(dest/'execution.json'),
 'raw_output_hashes_verified':True,
 'endpoint_time':1.,'nodal_rows_per_block':len(nodes),'integration_points_per_block':len(points),
 'independent_EA_L_extension_mm':delta,'reference_u3_mm':u[900][2],'weighted_face_u3_mm':mean,'mpc_residual_mm':mpc_residual,
 'maximum_affine_displacement_error_mm':max_u_error,
 'maximum_bottom_nodal_reaction_error_n':max_bottom_error,'maximum_top_transfer_force_error_n':max_top_error,
 'maximum_stress_error_mpa':max_stress_error,'maximum_strain_error':max_strain_error,
 'fixture_support_force_n':support,'force_residual_n':force_residual,'moment_residual_nmm':moment_residual,
 'maximum_lateral_guide_reaction_n':max(map(abs,guide_values)),'maximum_rotation_guide_moment_nmm':max(map(abs,rf[901])),
 'reference_node_reported_RF':rf[900],
 'force_accounting':'Global equilibrium uses explicit external CLOAD plus fixture support reactions. Bolt-top nodal forces separately verify MPC transfer; do not double-count them as extra external load. Reference-node RF is zero in this output and is not the transferred axial force.',
 'solver_warning':'Requested minimum increment1e-8 was changed to1e-6 by CCX. The single actual increment remained1.0 and reached the frozen endpoint.',
 'limits':['This validates one axial scalar mean constraint in a guided linear-elastic fixture, not actual nut threads, preload, radial engagement, current joint response, or capacity.','Guides are fixture supports only and must not be transferred to the current joint.'],
}
assert not (dest/'parent-audit.json').exists()
(dest/'parent-audit.json').write_text(json.dumps(output,indent=2,sort_keys=True,allow_nan=False)+'\n')
shutil.copyfile(__file__,dest/'parent-audit.py.snapshot')
print(json.dumps(output,indent=2),flush=True)
