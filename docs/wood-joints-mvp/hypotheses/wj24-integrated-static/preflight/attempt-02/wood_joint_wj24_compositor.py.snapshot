LAYOUT_ID = "wj24-twenty-four-duty-integrated-static-v1"
TRIAL_ID = "wj24-wj18-plus-top-center-bottom-pairs-v1"
SOURCE_RECONSTRUCTION_TOLERANCE_MM3 = 1e-3

BOTTOM_OUTER_AXIS_STATION_IDS = {
    f"bottom_outer/{duty_id}/{role}_{index}": duty_id
    for duty_id in sorted(bottom_outer.TARGET_DUTY_IDS)
    for role in ("rail", "side")
    for index in (1, 2)
}

EXPECTED_TARGET_DUTY_IDS = frozenset(
    wj18.EXPECTED_TARGET_DUTY_IDS
    | top_center.TARGET_DUTY_IDS
    | bottom_outer.TARGET_DUTY_IDS
    | bottom_center.TARGET_DUTY_IDS
)
EXPECTED_SOURCE_HOST_IDS = frozenset(
    wj18.EXPECTED_SOURCE_HOST_IDS
    | top_center.HOST_IDS
    | bottom_outer.HOST_IDS
    | bottom_center.HOST_IDS
)
EXPECTED_CANDIDATE_AXIS_STATION_IDS = {
    **dict(wj18_diagnostic.WJ18_LAYOUT.expected_candidate_axis_station_ids),
    **dict(top_center.TOP_AXIS_STATION_IDS),
    **BOTTOM_OUTER_AXIS_STATION_IDS,
    **dict(bottom_center.BOTTOM_AXIS_STATION_IDS),
}
EXPECTED_CANDIDATE_AXIS_IDS = frozenset(EXPECTED_CANDIDATE_AXIS_STATION_IDS) | frozenset(
    wj18.EXPECTED_CANDIDATE_AXIS_IDS
    - set(wj18_diagnostic.WJ18_LAYOUT.expected_candidate_axis_station_ids)
)
EXPECTED_CANDIDATE_PART_IDS = frozenset(
    wj18.EXPECTED_CANDIDATE_PART_IDS
    | top_center.TOP_CANDIDATE_PART_IDS
    | set(bottom_outer.CLEAT_IDS.values())
    | bottom_center.BOTTOM_CANDIDATE_PART_IDS
)
EXPECTED_REDIRECTED_PANEL_AXES = frozenset(
    row["axis_id"]
    for row in json.loads((ROOT / INVENTORY_PATH).read_text()).get(
        "fixed_panel_kicker_screws", ()
