        "base_rail_service_lower_left",
        "base_rail_service_upper_left",
    }
)
EXPECTED_CANDIDATE_COMPONENT_COUNT = 520
EXPECTED_REPLACED_SOURCE_AXIS_COUNT = 144
EXPECTED_FIXED_PANEL_AXIS_COUNT = 66
EXPECTED_FRAME_BOLT_COUNT = 12
EXPECTED_FRAME_BOLT_COMPONENT_COUNT = 60
EXPECTED_FRAME_BOLT_PROXY_COUNT = 12
EXPECTED_FRAME_BOLT_SHAPE_COUNT = 72

PRODUCER_HASH_PATHS = {
    "wj24_compositor": "scripts/wood_joint_wj24_compositor.py",
    "wj24_diagnostic": "scripts/wood_joint_wj24_diagnostic.py",
    "wj18_compositor": "scripts/wood_joint_wj18_compositor.py",
