@dataclass(frozen=True)
class SourceLocalFrame:
    """Inventory local datum expressed as an orthonormal global frame."""

    origin: cq.Vector
    x: cq.Vector
    t: cq.Vector
    n: cq.Vector

    def point(self, x_mm: float, t_mm: float, n_mm: float) -> cq.Vector:
        return (
            self.origin
            + self.x * float(x_mm)
            + self.t * float(t_mm)
            + self.n * float(n_mm)
        )

    def coordinates(self, point: cq.Vector) -> tuple[float, float, float]:
        delta = cq.Vector(point) - self.origin
        return delta.dot(self.x), delta.dot(self.t), delta.dot(self.n)


