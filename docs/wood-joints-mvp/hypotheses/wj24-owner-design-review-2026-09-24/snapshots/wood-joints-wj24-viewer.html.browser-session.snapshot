          data.bounded_led_extraction_summary?.whole_harness_transport_proven !== false) {
        throw new Error('WJ24 overlay, retained-source, or bounded LED diagnostic counts are invalid');
      }

      const baseline = groups.get('baseline');
      await Promise.all(parts.filter(part => !hidden.has(part.name)).map(async part => {
        const response = await fetch(part.path);
        if (!response.ok) throw new Error(`baseline asset unavailable: ${part.path}`);
        const bytes = await response.arrayBuffer();
        if (await sha256Bytes(bytes) !== data.baseline_asset_sha256[part.path]) throw new Error(`baseline asset hash changed: ${part.path}`);
        const geometry = loader.parse(bytes); geometry.computeVertexNormals();
        const mesh = new THREE.Mesh(geometry, materialForBaseline(part));
        if (part.translation_mm) mesh.position.fromArray(part.translation_mm);
        baseline.add(mesh);
      }));

      const triangleTopologies = new Map();
      for (const [digest, row] of Object.entries(data.triangle_topologies)) {
        const indices = decodeTypedArray(row.triangle_indices_base64, row.triangle_component_type, row.index_count);
        const bytes = Uint8Array.from(atob(row.triangle_indices_base64), character => character.charCodeAt(0));
        if (await sha256Bytes(bytes.buffer) !== digest || row.index_count !== row.triangle_count * 3) {
          throw new Error(`triangle topology hash or count mismatch: ${digest}`);
        }
        triangleTopologies.set(digest, {...row, indices});
      }
      const colors = {finished_host: 0x8a633f, candidate_part: 0xd09752, candidate_hardware: 0x9fc4d6, panel_replacement: 0x45525a};
      for (const row of data.solids) {
        const hardware = row.display_class === 'candidate_hardware';
        const material = new THREE.MeshStandardMaterial({
          color: colors[row.display_class], metalness: hardware ? .42 : 0,
          roughness: hardware ? .34 : .76, transparent: hardware || row.display_class === 'panel_replacement',
          opacity: hardware ? .76 : row.display_class === 'panel_replacement' ? .5 : 1,
          depthWrite: !hardware,
        });
        groups.get(row.display_class).add(new THREE.Mesh(meshGeometry(row.mesh, triangleTopologies), material));
      }

      document.querySelector('#scope').textContent = data.scope;
      document.querySelector('#identity').textContent = `Source commit ${data.source_binding.source_commit} · inventory SHA-256 ${data.source_binding.source_inventory_sha256} · composition ${data.source_binding.composition_report_sha256} · diagnostic ${data.source_binding.diagnostic_report_sha256}.`;
      document.querySelector('#counts').textContent = `24 duties · 16 shared hosts · 28 candidate parts · 104 axes / 520 hardware occupancy roles · 66 fixed Hillman axes · 12 starting frame bolts.`;
      status.textContent = `Pinned baseline assets verified: ${parts.length - hidden.size} visible once; ${hidden.size} legacy/replaced visuals suppressed.`;
      document.querySelector('#release-boundary').textContent = `All acceptance and release flags are false. Layout status: ${data.layout_status}.`;
      for (const limit of data.limits) { const li = document.createElement('li'); li.textContent = limit; document.querySelector('#limits').append(li); }
      for (const row of data.findings) document.querySelector('#finding-list').append(renderFinding(row));

      const finite = data.finite_contact_supplement.report;
      const leftRail = finite.interfaces.find(row => row.host_id === 'base_rail_bottom_left');
      const leftCut = finite.left_service_cut;
      const hold = finite.G1_provisional_hold_projection;
      fact(document.querySelector('#finite-contact'), `Bottom-left rail finite common face: ${leftRail.finite_common_area_mm2.toFixed(6)} mm² of ${leftRail.cleat_planar_area_mm2.toFixed(6)} mm² nominal cleat face; ${leftCut.cut_id} accounts for ${leftCut.analytic_cap_area_mm2.toFixed(6)} mm² and ${leftCut.missing_slab_volume_mm3.toFixed(6)} mm³ missing from the ${leftCut.slab_depth_mm} mm comparison slab.`, 'open');
      fact(document.querySelector('#finite-contact'), `G1 provisional Ø${hold.proxy_diameter_mm} × ${hold.proxy_length_mm} mm projection overlaps the right cleat by ${hold.overlap_volume_mm3.toFixed(6)} mm³ from ${hold.overlap_stations_from_panel_rear_mm[0]} to ${hold.overlap_stations_from_panel_rear_mm[1]} mm behind the panel rear. This is not a selected or approved bolt.`, 'open');
      const accessHits = data.diagnostic_report.candidate_bodies.candidate_body_vs_access_envelope_hits_mm3;
      const holdHits = Object.entries(accessHits).flatMap(([body, hits]) => Object.entries(hits).map(([envelope, overlap]) => ({body, envelope, overlap})));
      const g12 = holdHits.find(row => row.envelope.endsWith('/hold_tnut_main_G12'));
      const g1 = holdHits.find(row => row.envelope.endsWith('/hold_tnut_main_G1'));
      if (!g1 || !g12) throw new Error('full-scene diagnostic does not preserve both G1 and G12 proxy hits');
      fact(document.querySelector('#finite-contact'), `Full-scene hold/access proxy hits: G1 against ${g1.body}, ${g1.overlap.toFixed(6)} mm³; G12 against ${g12.body}, ${g12.overlap.toFixed(6)} mm³. Neither is selected or approved hold-bolt geometry.`, 'open');
      const ledReport = data.led_extraction_diagnostic.report;
      const ledHit = ledReport.rows.flatMap(row => Object.entries(row.positive_volume_hits_mm3).map(([obstacle, overlap]) => ({row, obstacle, overlap})));
      if (ledHit.length !== 1 || ledReport.light_count !== 132 || ledReport.stationary_shape_count !== 842) throw new Error('LED extraction diagnostic identity or counts are invalid');
      const hit = ledHit[0];
      fact(document.querySelector('#led-extraction'), `Bounded individual LED axial extraction: ${ledReport.light_count} light envelopes checked against ${ledReport.stationary_shape_count} stationary shapes. ${hit.row.light_id} withdraws ${hit.row.stroke_mm.toFixed(6)} mm and intersects ${hit.obstacle} by ${hit.overlap.toFixed(6)} mm³; the other 131 sweeps have no positive-volume hit in this operation.`, 'open');
      fact(document.querySelector('#led-extraction'), 'This is an individual axial sweep only. It excludes wire flexibility/slack, connector feeding, neighboring lights, latch operation, and alternative supported staging; it does not prove whole-harness transport or assembly.', 'open');
      jsonDetails(document.querySelector('#findings'), 'Finite contact and hold-projection evidence', finite);
      jsonDetails(document.querySelector('#findings'), 'Bounded LED extraction evidence', ledReport);
      jsonDetails(document.querySelector('#findings'), 'Full-scene diagnostic gates', data.diagnostic_report.diagnostic_gates);
      jsonDetails(document.querySelector('#findings'), 'Candidate body and access-envelope intersections', data.diagnostic_report.candidate_bodies);
      jsonDetails(document.querySelector('#findings'), 'Retained family tool/contact diagnostics', data.diagnostic_report.local_family_diagnostics);
      jsonDetails(document.querySelector('#report-details'), 'Source-bound composition report', data.composition_report);
      jsonDetails(document.querySelector('#report-details'), 'Full-scene diagnostic report', data.diagnostic_report);
      jsonDetails(document.querySelector('#report-details'), 'LED extraction diagnostic', ledReport);
      jsonDetails(document.querySelector('#report-details'), 'Baseline visual policy', data.baseline_scene_policy);
      updateModelBounds();
      view('');
      }
    } catch (error) {
      document.querySelector('#scope').textContent = 'The current WJ24 review scene is unavailable or failed its identity check.';
      document.querySelector('#revision-status').textContent = 'The current WJ24 review scene could not be verified.';
      status.textContent = `Viewer unavailable: ${error.message}. Serve the site over HTTP and check the pinned scene and baseline files.`;
      status.className = 'open';
      status.setAttribute('role', 'alert');
      status.setAttribute('aria-live', 'assertive');
    }

    renderer.setAnimationLoop(() => { controls.update(); renderer.render(scene, camera); });
  </script>
</body>
</html>
