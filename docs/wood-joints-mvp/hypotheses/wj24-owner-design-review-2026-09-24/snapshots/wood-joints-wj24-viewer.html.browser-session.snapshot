      }

      const statusSentence = `Design review only. ${report.summary} No earlier static or diagnostic pass is carried into this revision; no acceptance or release is granted.`;
      setViewerMode({
        title: 'WJ24 owner-directed design review',
        status: statusSentence,
        label: 'Design review',
        description: `This scene shows the geometry in the current owner-directed design-review revision. Candidate hardware is represented as CAD occupancy envelopes, not selected or delivered components. ${inventory.moved_panel_axes.length ? `${inventory.moved_panel_axes.length} existing panel-screw visuals use explicit revision display translations; their pinned baseline mesh assets remain hash-checked.` : 'No panel-screw display translations are specified for this revision.'} The view does not establish acceptance, capacity, installation, fabrication, assembly, structural release, or climbing release.`,
        geometrySummary: 'Current revision checks and findings',
        reportSummary: 'Current revision report and source identity',
        instructions: 'Interactive three-dimensional WJ24 design-review scene. Drag with a pointer or touch to rotate, and use the mouse wheel or pinch to zoom. You can also focus the scene and use the arrow keys to rotate and plus or minus to zoom. The inspection panel has buttons for the left end, right end, and full frame, plus checkboxes for scene layers. This scene is for design review and does not establish acceptance or release.',
      });
      document.querySelector('#scope').textContent = report.summary;
      document.querySelector('#geometry-status').textContent = `Current revision ${revisionId}. The report below contains the geometry checks supplied for this revision.`;
      document.querySelector('#identity').textContent = `Revision ${revisionId} · source commit ${binding.source_commit} · source inventory SHA-256 ${binding.source_inventory_sha256} · parent scene SHA-256 ${binding.parent_scene_sha256} · revision report SHA-256 ${binding.revision_report_sha256}.`;
      document.querySelector('#counts').textContent = `${inventory.target_duties.length} duties · ${Object.keys(inventory.shared_hosts).length} shared hosts · ${Object.keys(inventory.candidate_parts).length} candidate parts · ${Object.keys(inventory.candidate_axes).length} candidate axes / ${expectedHardwareIds.length} hardware occupancy roles · ${inventory.fixed_panel_axes.length} fixed + ${inventory.moved_panel_axes.length} moved panel-screw axes · ${inventory.frame_bolts.length} retained frame bolts.`;
      document.querySelector('#release-boundary').textContent = 'Every acceptance and release flag is false. This revision is a design review only.';
      const alternatives = document.createElement('a');
      alternatives.href = 'wood-joints-kicker-options.html';
      alternatives.textContent = 'Explore separate frame-to-kicker options; no option is selected.';
      document.querySelector('#revision-links').append(alternatives);
      for (const limit of data.limits) { const li = document.createElement('li'); li.textContent = limit; document.querySelector('#limits').append(li); }
      for (const row of data.findings) document.querySelector('#finding-list').append(renderFinding(row));
      const checks = data.revision_checks || report.geometry_checks || report.checks;
      document.querySelector('#geometry-status').textContent += checks ? ` ${Array.isArray(checks) ? checks.length : Object.keys(checks).length} current geometry checks are recorded.` : '';
      if (checks) jsonDetails(document.querySelector('#findings'), 'Current revision geometry checks', checks);
      jsonDetails(document.querySelector('#findings'), 'Current revision findings', data.findings);
      jsonDetails(document.querySelector('#report-details'), 'Current revision report', report);
      jsonDetails(document.querySelector('#report-details'), 'Source binding', binding);
      jsonDetails(document.querySelector('#report-details'), 'Baseline visual policy', policy);
      const baselineDisplayTranslations = data.baseline_display_translations_mm;
      if (!baselineDisplayTranslations || typeof baselineDisplayTranslations !== 'object' || Array.isArray(baselineDisplayTranslations) ||
          !sameIds(Object.keys(baselineDisplayTranslations), movedPanelVisuals) ||
          Object.entries(baselineDisplayTranslations).some(([name, translation]) =>
            !parts.some(part => part.name === name) || !Array.isArray(translation) || translation.length !== 3 || translation.some(value => !Number.isFinite(value)))) {
        throw new Error('WJ24 moved panel-screw baseline transforms do not match the current revision inventory');
      }
      const displayParts = parts.map(part => baselineDisplayTranslations[part.name]
        ? {...part, translation_mm: baselineDisplayTranslations[part.name]}
        : part);
      await renderSceneGeometry(data, displayParts, hidden);
      status.textContent = `Pinned baseline assets verified: scene rendered with ${parts.length - hidden.size} visible once and ${hidden.size} source visuals replaced.`;
    }

    try {
      const [manifestResponse, sceneResponse] = await Promise.all([
        fetch('hybrid/compact-floor-flush-kerf-right/parts.json'),
        fetch('owner-wood-joints-wj24-scene.json'),
      ]);
      if (!manifestResponse.ok || !sceneResponse.ok) throw new Error('scene files unavailable');
      const [manifestText, data] = await Promise.all([manifestResponse.text(), sceneResponse.json()]);
      const manifest = JSON.parse(manifestText);
      const parts = manifest.parts;
      if (data.schema === 'owner_wood_joints_design_review_scene/v1') {
        await renderDesignReview(data, manifestText, parts);
      } else {
      setViewerMode({
        title: 'WJ24 integrated wood-joint development',
        status: 'REVISE — provisional diagnostic scene. Not accepted or build-ready.',
        label: 'REVISE',
        description: 'This scene combines the full 24-duty nominal layout with the pinned kerf-right baseline context. Blue candidate hardware shapes are CAD occupied envelopes, not selected or delivered components. The 66 Hillman screws and twelve starting frame-bolt arrangements remain rendered once from the baseline.',
        geometrySummary: 'Known geometry and access findings',
        reportSummary: 'Full source-bound composition and diagnostic reports',
        instructions: 'Interactive three-dimensional development scene. Drag with a pointer or touch to rotate, and use the mouse wheel or pinch to zoom. You can also focus the scene and use the arrow keys to rotate and plus or minus to zoom. The inspection panel has buttons for the left end, right end, and full frame, plus checkboxes for scene layers. The scene is marked REVISE and does not establish acceptance, capacity, installation, fabrication, structural release, or climbing release.',
      });
      document.querySelector('#geometry-status').textContent = 'G1 and G12 are provisional hold-envelope probes; their intersections remain visible and do not select a bolt length.';
      document.querySelector('#geometry-status').className = 'open';
      const releaseFlags = ['integrated_scene_is_accepted','complete_joint_acceptance','capacity_established','installation_proven','fabrication_released','structural_released','climbing_released'];
      const sourceReleaseFlags = ['candidate_accepted','source_cutting_released','drilling_released','fabrication_released','structural_accepted','assembly_proven'];
      if (data.schema !== 'owner_wood_joints_wj24_diagnostic_scene/v1' ||
          data.layout_status !== 'REVISE' || data.layout_id !== 'wj24-twenty-four-duty-integrated-static-v1' ||
          data.trial_id !== 'wj24-wj18-plus-top-center-bottom-pairs-v1' ||
          data.candidate !== 'compact-floor-flush-wood-joints-development' ||
          data.baseline !== 'compact-floor-flush-kerf-right' ||
          releaseFlags.some(flag => data[flag] !== false) ||
          !data.release || sourceReleaseFlags.some(flag => data.release[flag] !== false) ||
          !Array.isArray(data.hidden_baseline_visual_names) || !Array.isArray(data.solids) ||
          data.solids.length !== 567 || !Array.isArray(parts) ||
          parts.length !== 725 ||
          !/^[0-9a-f]{40}$/i.test(data.source_binding?.source_commit || '') ||
          !/^[0-9a-f]{64}$/i.test(data.source_binding?.composition_report_sha256 || '') ||
          !/^[0-9a-f]{64}$/i.test(data.source_binding?.diagnostic_report_sha256 || '') ||
          !/^[0-9a-f]{64}$/i.test(data.source_binding?.led_extraction_report_sha256 || '') ||
          data.display_mesh_encoding?.encoding !== 'base64_typed_arrays_le_v1' ||
          data.display_mesh_encoding?.tessellation_tolerance_mm !== 0.5 ||
          data.display_mesh_encoding?.vertex_quantization_mm !== 0.1 ||
          data.display_mesh_encoding?.maximum_euclidean_vertex_quantization_error_mm >= 0.5 ||
          data.display_mesh_encoding?.cad_geometry_modified !== false ||
          data.display_mesh_encoding?.triangle_topologies_deduplicated !== true ||
          await sha256Text(manifestText) !== data.baseline_manifest_sha256) {
        throw new Error('WJ24 scene identity, mesh count, or release boundary is invalid');
      }
      const hidden = new Set(data.hidden_baseline_visual_names);
      const visibleNames = new Set(parts.filter(part => !hidden.has(part.name)).map(part => part.name));
      const comp = data.composition_report;
      const expectedHidden = new Set([
        ...Object.keys(comp.shared_hosts),
        ...comp.target_duties.map(row => row.station_id),
        ...comp.removed_source_axes.map(row => `fastener_${row.axis_id}`),
        ...Object.keys(comp.panel_replacements),
