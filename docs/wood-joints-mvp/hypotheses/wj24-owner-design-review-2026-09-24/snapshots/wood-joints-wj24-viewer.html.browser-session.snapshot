      const expectedFixedVisuals = [...inventory.fixed_panel_axes.map(id => `fastener_${id}`), ...movedPanelVisuals];
      const expectedFrameIds = inventory.frame_bolts.map(row => row.axis_id);
      const expectedFrameVisuals = expectedFrameIds.flatMap(id => ['shaft','near_washer','far_washer','head','nut'].map(role => `fastener_${id}_${role}`));
      const fixedVisuals = policy?.retained_fixed_axis_ids?.map(id => `fastener_${id}`) || [];
      const frameVisuals = policy?.retained_frame_bolt_ids?.flatMap(id => ['shaft','near_washer','far_washer','head','nut'].map(role => `fastener_${id}_${role}`)) || [];
