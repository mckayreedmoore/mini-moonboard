      const overlayCounts = Object.fromEntries([...allowedClasses].map(name => [name, data.solids.filter(row => row.display_class === name).length]));
      if (JSON.stringify(overlayCounts) !== JSON.stringify({finished_host:16,candidate_part:28,candidate_hardware:520,panel_replacement:3}) ||
          new Set(data.solids.map(row => row.id)).size !== 567 ||
