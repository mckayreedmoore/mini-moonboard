          !sameIds(policy?.retained_fixed_axis_ids, inventory.fixed_panel_axes) ||
          !sameIds(policy?.retained_frame_bolt_ids, expectedFrameIds) ||
          !sameIds(policy?.retained_fixed_axis_visual_names, expectedFixedVisuals) ||
          !sameIds(policy?.retained_frame_bolt_visual_names, expectedFrameVisuals) ||
          policy?.hidden_counts?.rebuilt_shared_hosts !== 16 || policy?.hidden_counts?.replaced_legacy_clips !== 24 ||
          policy?.hidden_counts?.replaced_legacy_sds_visuals !== 144 || policy?.hidden_counts?.replaced_right_panels !== 3 ||
          policy?.preserved_visual_counts?.fixed_hillman_axes !== inventory.panel_screw_axis_count ||
          policy?.preserved_visual_counts?.frame_bolt_physical_components !== 60 ||
          policy?.preserved_visual_counts?.tnuts !== 142 || policy?.preserved_visual_counts?.lights !== 132 ||
          policy?.preserved_visual_counts?.wires !== 131 || policy?.retained_fixed_axis_ids?.length !== inventory.fixed_panel_axes.length ||
          policy?.retained_frame_bolt_ids?.length !== 12 || policy?.retained_frame_bolt_axis_proxies_rendered !== false) {
        throw new Error('WJ24 design-review baseline policy would duplicate or hide retained source hardware/services');
      }

      const allowedClasses = assertDisplayMeshes(data);
      const overlayCounts = Object.fromEntries([...allowedClasses].map(name => [name, data.solids.filter(row => row.display_class === name).length]));
      const expectedHardwareIds = Object.entries(inventory.candidate_axes).flatMap(([axis, row]) => {
        if (!Array.isArray(row.installed_role_ids)) throw new Error(`WJ24 candidate-axis roles missing: ${axis}`);
        return row.installed_role_ids.map(role => `${axis}/${role}`);
