      const expectedFixedVisuals = comp.fixed_panel_axes.map(id => `fastener_${id}`);
      const expectedFrameIds = comp.starting_frame_bolts.map(row => row.axis_id);
      const expectedFrameVisuals = expectedFrameIds.flatMap(id =>
