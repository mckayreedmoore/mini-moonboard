          !sameIds(data.baseline_scene_policy.retained_fixed_axis_ids, comp.fixed_panel_axes) ||
          !sameIds(data.baseline_scene_policy.retained_frame_bolt_ids, expectedFrameIds) ||
          !sameIds(data.baseline_scene_policy.retained_fixed_axis_visual_names, expectedFixedVisuals) ||
          !sameIds(data.baseline_scene_policy.retained_frame_bolt_visual_names, expectedFrameVisuals) ||
          data.baseline_scene_policy.hidden_counts?.rebuilt_shared_hosts !== 16 ||
          data.baseline_scene_policy.hidden_counts?.replaced_legacy_clips !== 24 ||
          data.baseline_scene_policy.hidden_counts?.replaced_legacy_sds_visuals !== 144 ||
          data.baseline_scene_policy.hidden_counts?.replaced_right_panels !== 3 ||
          data.baseline_scene_policy.preserved_visual_counts.fixed_hillman_axes !== 66 ||
          data.baseline_scene_policy.preserved_visual_counts.frame_bolt_physical_components !== 60 ||
          data.baseline_scene_policy.preserved_visual_counts.tnuts !== 142 ||
          data.baseline_scene_policy.preserved_visual_counts.lights !== 132 ||
          data.baseline_scene_policy.preserved_visual_counts.wires !== 131) {
        throw new Error('baseline visual replacement would duplicate or hide retained source hardware/services');
      }
      const allowedClasses = new Set(['finished_host','candidate_part','candidate_hardware','panel_replacement']);
      if (!data.solids.every(row => allowedClasses.has(row.display_class) && row.mesh?.encoding === 'base64_typed_arrays_le_v1' &&
          ['int16','int32'].includes(row.mesh.vertex_component_type) && ['uint16','uint32'].includes(row.mesh.triangle_component_type) &&
          Number.isInteger(row.mesh.vertex_count) && Number.isInteger(row.mesh.triangle_count) &&
          /^[0-9a-f]{64}$/i.test(row.mesh.triangle_topology_sha256 || '') &&
