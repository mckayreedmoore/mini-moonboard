          !sameIds(data.solids.filter(row => row.display_class === 'candidate_part').map(row => row.id), Object.keys(comp.candidate_parts)) ||
          !sameIds(data.solids.filter(row => row.display_class === 'panel_replacement').map(row => row.id), Object.keys(comp.panel_replacements)) ||
