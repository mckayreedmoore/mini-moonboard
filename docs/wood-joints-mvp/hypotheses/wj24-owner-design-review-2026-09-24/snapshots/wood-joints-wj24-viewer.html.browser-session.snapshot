        throw new Error('WJ24 design-review model inventory is incomplete');
      }
      if (!Array.isArray(inventory.target_duties) || inventory.target_duties.some(row => typeof row.station_id !== 'string') ||
          inventory.removed_source_axes.some(row => typeof row.axis_id !== 'string') ||
          inventory.moved_panel_axes.some(row => typeof row.axis_id !== 'string' || row.visual_name !== `fastener_${row.axis_id}`) ||
          inventory.starting_frame_bolts.some(row => typeof row.axis_id !== 'string') ||
          inventory.frame_bolts.some(row => typeof row.axis_id !== 'string') ||
          !sameIds(inventory.starting_frame_bolts.map(row => row.axis_id), inventory.frame_bolts.map(row => row.axis_id)) ||
          inventory.panel_screw_axis_count !== inventory.fixed_panel_axes.length + inventory.moved_panel_axes.length) {
