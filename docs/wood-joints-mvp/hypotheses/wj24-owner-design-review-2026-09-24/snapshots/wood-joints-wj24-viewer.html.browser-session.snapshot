          !sameIds(data.solids.filter(row => row.display_class === 'candidate_part').map(row => row.id), Object.keys(inventory.candidate_parts)) ||
          !sameIds(data.solids.filter(row => row.display_class === 'panel_replacement').map(row => row.id), Object.keys(inventory.panel_replacements)) ||
          !sameIds(data.solids.filter(row => row.display_class === 'candidate_hardware').map(row => row.id), expectedHardwareIds) ||
