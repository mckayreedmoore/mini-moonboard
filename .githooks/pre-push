#!/usr/bin/env python3
"""Publication-window guard for automated agent workflows."""
import sys
from datetime import datetime
from zoneinfo import ZoneInfo


def blocked(now):
    local = now.astimezone(ZoneInfo("America/Denver"))
    return local.weekday() < 4 and 450 <= local.hour*60+local.minute < 1080


if __name__ == "__main__" and blocked(datetime.now().astimezone()):
    print("Agent publication window is closed: Monday–Thursday "
          "07:30–18:00 America/Denver. Continue local work and retry "
          "during the publication window.", file=sys.stderr)
    sys.exit(1)
